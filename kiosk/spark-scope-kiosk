#!/bin/sh
# Shows the Spark Scope rack panel full screen in Chromium, for a bar display on a Raspberry Pi
# (Raspberry Pi OS with labwc/Wayland) or any other Linux desktop. Install as ~/.local/bin/spark-scope-kiosk.
#
# SPARK_SCOPE_RACK_URL  the panel to show (default: a dashboard on this machine). For a dashboard on
#                       another machine use e.g. http://dashboard-host:8787/rack/ ; for a display that
#                       is not 4:1, add ?width=N (see README).
# CHROMIUM              the browser binary (default: chromium, then chromium-browser).
URL="${SPARK_SCOPE_RACK_URL:-http://127.0.0.1:8787/rack/}"
# Shortest match, so a host name that itself starts with "rack" (rack-pi.local) survives.
BASE="${URL%/rack*}"
CHROMIUM="${CHROMIUM:-$(command -v chromium || command -v chromium-browser)}"
if [ -z "$CHROMIUM" ]; then
  echo "spark-scope-kiosk: Chromium not found; set CHROMIUM=/path/to/chromium" >&2
  exit 1
fi
# Wait until the dashboard answers (any HTTP status) so Chromium never opens on an error page; say so once a minute.
tries=0
until curl -s -o /dev/null --max-time 3 "$BASE/api/health"; do
  [ $((tries % 12)) -eq 0 ] && echo "spark-scope-kiosk: waiting for $BASE/api/health" >&2
  tries=$((tries + 1))
  sleep 5
done
# Wayland when a Wayland display is there (Raspberry Pi OS with labwc), even if XDG_SESSION_TYPE is not set,
# for example when the kiosk is started over SSH; otherwise let Chromium pick (X11 desktops).
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  PLATFORM="--ozone-platform=wayland"
else
  PLATFORM="--ozone-platform-hint=auto"
fi
# --class sets the window's app_id (WM_CLASS on X11), so the labwc rule in labwc-rc.xml matches only this window.
# Raspberry Pi OS starts every Chromium with --force-renderer-accessibility (/etc/chromium.d), which rebuilds an
# accessibility tree on each redraw; the panel has no reader and no input, so the kiosk turns it off.
exec "$CHROMIUM" "$PLATFORM" --class=spark-scope-kiosk \
  --kiosk --noerrdialogs --disable-infobars --no-first-run \
  --disable-renderer-accessibility \
  --disable-session-crashed-bubble --hide-crash-restore-bubble \
  --disable-features=Translate --password-store=basic \
  --check-for-update-interval=31536000 --overscroll-history-navigation=0 \
  --user-data-dir="$HOME/.local/share/spark-scope-kiosk" \
  "$URL"
